# Virtual environment
.venv/
.claude/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# macOS
.DS_Store

# Data caches: large, and fully regenerable from the recorded sources (P1).
# Leading slash anchors this to the repository root. Without it the pattern
# would also match `src/rrc/data/`, silently untracking the data *package*.
/data/

# Per-run artifacts and figures are regenerable (`make figures`), so they are
# not versioned - but the directories are kept so a fresh clone has the layout.
results/runs/*
!results/runs/.gitkeep
results/figures/*
!results/figures/.gitkeep

# NOTE: results/registry.csv is deliberately NOT ignored.
# It is the append-only audit trail that every claim in the dissertation traces
# back to, and the source of the deflated-Sharpe trial count. It must be
# versioned alongside the code that produced it.

# Exploratory diagnostics: regenerable with `make diagnostics`, and not
# results of record, so the images themselves are not versioned.
results/diagnostics/*
!results/diagnostics/.gitkeep

# ---------------------------------------------------------------------------
# P2 (backtest engine) — parked, commented out.
# Uncomment individual lines to stop tracking a file, then run:
#     git rm --cached <path>
# (.gitignore alone does not untrack a file that is already committed.)
#
# src/rrc/backtest/ledger.py
# src/rrc/backtest/costs.py
# src/rrc/backtest/metrics.py
# tests/test_ledger.py
# tests/test_metrics.py
# scripts/run_smoke_backtest.py
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# P3 (reservoir) — parked, commented out.
# Same rules as the P2 block above: uncomment a line to stop tracking it, then
#     git rm --cached <path>
#
# src/rrc/reservoir/scr.py
# src/rrc/reservoir/esn.py
# src/rrc/reservoir/cache.py
# src/rrc/reservoir/diagnostics.py
# tests/test_reservoir.py
# scripts/run_reservoir.py
# configs/reservoir.yaml
